# Nextcloud server URL (including https://)
NC_URL=url-here

# Nextcloud username
NC_USERNAME=username-here

# Nextcloud App Password (Settings > Personal > Security > Create new app password)
NC_APP_PASSWORD=your-app-password-here

# Form ID (integer from Forms API or URL)
FORM_ID=form-id-here

# Table ID (integer from table settings)
TABLE_ID=table-id-here

# Exact title of the datetime column in the table
TIMESTAMP_COLUMN_NAME=timestamp-column-title-here

# Field mapping as JSON: {questionId: "exact column title"}
FIELD_MAPPING={"id1":"name1","id2":"name2",...}
